{
	"name": "museum-app",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"serve": "node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
		"build": "npm run typecheck && node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js build",
		"lint": "eslint --ext .ts,.vue src tests --max-warnings 0",
		"test": "tsx --test tests/*.test.ts",
		"typecheck": "vue-tsc --noEmit",
		"lint:fix": "eslint --ext .ts,.vue src tests --fix"
	},
	"dependencies": {
		"axios": "^0.21.1",
		"core-js": "^3.6.5",
		"vue": "2.7.16",
		"vue-router": "^3.5.1",
		"vuetify": "^2.4.0",
		"vuex": "^3.6.2"
	},
	"devDependencies": {
		"@types/node": "18.19.0",
		"@types/webpack-env": "1.18.8",
		"@typescript-eslint/eslint-plugin": "5.62.0",
		"@typescript-eslint/parser": "5.62.0",
		"@vue/cli-plugin-babel": "~4.5.0",
		"@vue/cli-plugin-typescript": "4.5.19",
		"@vue/cli-service": "~4.5.0",
		"eslint": "8.57.1",
		"eslint-plugin-vue": "9.33.0",
		"sass": "^1.32.0",
		"sass-loader": "^10.0.0",
		"tsx": "4.20.6",
		"typescript": "4.9.5",
		"vue-cli-plugin-vuetify": "~2.3.1",
		"vue-template-compiler": "2.7.16",
		"vue-tsc": "1.8.27",
		"vuetify-loader": "^1.7.0"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead"
	],
	"vue": {
		"transpileDependencies": [
			"vuetify"
		]
	},
	"engines": {
		"node": ">=18"
	}
}
